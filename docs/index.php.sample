<?php

// Aux function for loading docker env variables
if (!function_exists('getenv_docker')) {
    function getenv_docker($env, $default)
    {
        $fileEnv = getenv($env . '_FILE');
        if ($fileEnv && file_exists($fileEnv)) {
            return rtrim(file_get_contents($fileEnv), "\r\n");
        }
        $val = getenv($env);
        return ($val !== false) ? $val : $default;
    }
}

// Env constants
define('APPLICATION_ENV', getenv_docker('APP_ENV', 'production'));

// Base routes
define('ROOT_DIR', realpath(__DIR__ . '/..'));
define('APPLICATION_PATH', ROOT_DIR . '/application');

// Include path
$paths = [

    '/var/www/html/weblibs/Zend-1.12.17',
    '/var/www/html/weblibs/fpdf16',
    '/var/www/html/weblibs/PHPExcel-1.7.5/Classes',
    '/var/www/html/weblibs/html2pdf-4.5.0',
    get_include_path()
];
set_include_path(implode(PATH_SEPARATOR, $paths));

// Database & Cache Credentials for application.ini
$envConstants = [
    'DB_HOST'    => 'unknown',
    'DB_PORT'    => '3306',
    'DB_NAME'    => 'unknown',
    'DB_USER'    => 'unknown',
    'DB_PASS'    => 'unknown',
    'REDIS_HOST' => 'redis',
    'REDIS_PORT' => '6379'
];
foreach ($envConstants as $const => $default) {
    if (!defined($const)) {
        define($const, getenv_docker($const, $default));
    }
}

// Composer autoloader
$composerAutoload = ROOT_DIR . '/vendor/autoload.php';
if (file_exists($composerAutoload)) {
    require_once $composerAutoload;
}

/** Zend_Application */
require_once 'Zend/Application.php';

// --- Global Error & Exception Forwarding to stderr (for Docker/Loki observability) ---
// Catches PHP fatals, parse errors, and warnings that bypass Zend's ErrorController.
// These are forwarded via error_log() which, thanks to PHP-FPM catch_workers_output=yes,
// flows into Docker container logs and is picked up by Grafana Alloy / Loki.

register_shutdown_function(function () {
    $error = error_get_last();
    if ($error && in_array($error['type'], [E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR, E_USER_ERROR])) {
        error_log(sprintf(
            '[ZF1 FATAL] %s in %s:%d',
            $error['message'],
            $error['file'],
            $error['line']
        ));
    }
});

set_error_handler(function ($errno, $errstr, $errfile, $errline) {
    if (!(error_reporting() & $errno)) {
        return false; // Respect @ suppression and error_reporting level
    }
    $map = [
        E_WARNING         => 'WARNING',
        E_NOTICE          => 'NOTICE',
        E_DEPRECATED      => 'DEPRECATED',
        E_USER_WARNING    => 'USER_WARNING',
        E_USER_NOTICE     => 'USER_NOTICE',
        E_USER_DEPRECATED => 'USER_DEPRECATED',
    ];
    $level = $map[$errno] ?? 'ERROR';
    error_log(sprintf('[PHP %s] %s in %s:%d', $level, $errstr, $errfile, $errline));
    return false; // Let PHP continue its normal handling (e.g., log to file)
});

// App bootstrap
$application = new Zend_Application(
    APPLICATION_ENV,
    APPLICATION_PATH . '/configs/application.ini'
);

$application->bootstrap()->run();
