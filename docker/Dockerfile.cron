# Lightweight CLI image for running scheduled tasks (cron)
# Uses serversideup/php CLI variant — no Apache, no FPM (~150-200MB lighter)
ARG PHP_VERSION=8.5

# Choose our base image
FROM serversideup/php:${PHP_VERSION}-cli

# Arguments coming from docker-compose to handle permissions dynamically
ARG USER_ID=1000
ARG GROUP_ID=1000

# Switch to root to perform system-level configuration
USER root

# --- DEBIAN ARCHIVE FIX ---
# Debian 11 (Bullseye) reached end of LTS and moved to archive.debian.org.
# In archive.debian.org, Bullseye packages (including all 11.11 security updates) are consolidated
# into a single "bullseye" repository without separate security/updates suites.
RUN if grep -q "bullseye" /etc/os-release 2>/dev/null; then \
        echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until && \
        echo 'deb http://archive.debian.org/debian bullseye main contrib non-free' > /etc/apt/sources.list && \
        rm -f /etc/apt/sources.list.d/*.list; \
    elif grep -q "buster" /etc/os-release 2>/dev/null; then \
        echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until && \
        echo 'deb http://archive.debian.org/debian buster main contrib non-free' > /etc/apt/sources.list && \
        echo 'deb http://archive.debian.org/debian-security buster/updates main contrib non-free' >> /etc/apt/sources.list && \
        rm -f /etc/apt/sources.list.d/*.list; \
    fi
# --------------------------

# --- INSTALL CRON, TOOLS & BUILD LIBS ---
# The CLI image does not include cron or composer tools, so we install them explicitly
RUN apt-get update && \
    apt-get install -y --no-install-recommends cron git unzip zip libfontconfig1-dev libcairo2-dev libfreetype-dev && \
    rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_HOME=/var/www/html/tmp/composer \
    COMPOSER_CACHE_DIR=/var/www/html/tmp/composer/cache
# ----------------------------

# --- USER SYNC ---
# 1. Update www-data UID and GID to match the host user (e.g., 1002)
# 2. Use find to reassign ownership of existing files from the old ID (33) to the new one
RUN usermod -o -u ${USER_ID} www-data && \
    groupmod -o -g ${GROUP_ID} www-data && \
    [ -d "/var/www" ] && find /var/www -user 33 -exec chown -h www-data {} \; || true
# -----------------

# --- APP INITIALIZATION ---
# Copy the maintenance script
COPY docker/scripts/maintenance.sh /usr/local/bin/maintenance.sh
RUN chmod +x /usr/local/bin/maintenance.sh

# Install the same PHP extensions as the main app image
RUN install-php-extensions exif imagick gd intl redis

# The cron daemon requires root to read /etc/cron.d/ files.
# Individual cron jobs run as 'www-data' (specified in the crontab user column).
